{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "allowJs": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@app/config": ["../../packages/config/src/index.ts"],
      "@app/env": ["../../packages/env/src/index.ts"],
      "@app/ui": ["../../packages/ui/src/index.ts"],
      "@app/ports/*": ["../../packages/ports/src/*/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
