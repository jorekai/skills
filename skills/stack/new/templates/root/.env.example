# Two keys per port. A port whose two keys are both empty runs on its memory adapter, so the
# gate is green before any account exists. Values are never written here.
# db: empty means the memory adapter; (set in the secret store)
DB_URL=
DB_KEY=
# storage: empty means the memory adapter; (set in the secret store)
STORAGE_URL=
STORAGE_KEY=
# jobs: empty means the memory adapter; (set in the secret store)
JOBS_URL=
JOBS_KEY=
# host: empty means the memory adapter; (set in the secret store)
HOST_URL=
HOST_KEY=
# auth: empty means the memory adapter; (set in the secret store)
AUTH_URL=
AUTH_KEY=
# mail: empty means the memory adapter; (set in the secret store)
MAIL_URL=
MAIL_KEY=
# analytics: empty means the memory adapter; (set in the secret store)
ANALYTICS_URL=
ANALYTICS_KEY=
# errors: empty means the memory adapter; (set in the secret store)
ERRORS_URL=
ERRORS_KEY=
